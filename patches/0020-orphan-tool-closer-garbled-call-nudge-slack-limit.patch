From 77b85318a597dcf11e244ae866c825c0e7b30650 Mon Sep 17 00:00:00 2001
From: wray-lee <wray-lee@outlook.com>
Date: Sat, 17 Oct 2026 05:17:52 +0900
Subject: [PATCH] fix(reply): strip orphan tool-call closers, nudge on garbled
 text tool calls, keep Slack streams under msg_too_long

---
 src/agent/commands.zig                  |  49 ++++-
 src/agent/root.zig                      | 183 +++++++++++++++-
 src/channels/slack.zig                  |  95 +++++++-
 src/channels/slack_stream_presenter.zig |  82 ++++++-
 src/providers/helpers.zig               | 274 +++++++++++++++++++++++-
 src/streaming.zig                       | 111 +++++++++-
 6 files changed, 768 insertions(+), 26 deletions(-)

diff --git a/src/agent/commands.zig b/src/agent/commands.zig
index 10d4ff8..fb304f8 100644
--- a/src/agent/commands.zig
+++ b/src/agent/commands.zig
@@ -5428,12 +5428,22 @@ pub fn composeFinalReply(
     reasoning_content: ?[]const u8,
     usage: providers.TokenUsage,
 ) ![]const u8 {
+    // Never deliver tool-call markup to the user. A model can end its reply
+    // with a garbled text tool call (for example a lone `</function>` closer)
+    // that the parser could not turn into an executable call; the streaming
+    // TagFilter hides it from the live preview, but the final reply is
+    // authoritative, so strip it here exactly as the reasoning quote already
+    // is. Code fences and inline spans are preserved: a documented sample is
+    // not markup.
+    const clean_base = try providers.stripToolCallMarkup(self.allocator, base_text);
+    defer self.allocator.free(clean_base);
+
     // For reasoning_mode == .stream the thinking content is already printed
     // live during streaming via ThinkPassthroughFilter, so we must not
     // prepend it again here. Only .on mode shows the post-turn block.
     const show_reasoning = self.reasoning_mode == .on and reasoning_content != null and reasoning_content.?.len > 0;
     if (!show_reasoning and self.usage_mode == .off) {
-        return try self.allocator.dupe(u8, base_text);
+        return try self.allocator.dupe(u8, clean_base);
     }
 
     var out: std.ArrayListUnmanaged(u8) = .empty;
@@ -5456,7 +5466,7 @@ pub fn composeFinalReply(
         }
         try w.writeAll("\n\n");
     }
-    try w.writeAll(base_text);
+    try w.writeAll(clean_base);
 
     switch (self.usage_mode) {
         .off => {},
@@ -5997,6 +6007,41 @@ test "composeFinalReply stream mode does not prepend reasoning block" {
     try std.testing.expectEqualStrings("Answer", result);
 }
 
+test "composeFinalReply strips a lone orphan tool-call closer from the final answer" {
+    // Prod shape: the model announced one more round of work and then emitted a
+    // lone `</function>`; the parser found no executable call, so this reply was
+    // delivered verbatim (the orphan closer reached the user). It must not.
+    const allocator = std.testing.allocator;
+    var agent = FakeAgent{ .allocator = allocator, .reasoning_mode = .off };
+    const usage = providers.TokenUsage{};
+    const prod = "核心数据到手了。最后一轮，把对比表和机器参数抠准——电池容量是换算的关键。\n</function>";
+    const result = try composeFinalReply(&agent, prod, null, usage);
+    defer allocator.free(result);
+    try std.testing.expectEqualStrings("核心数据到手了。最后一轮，把对比表和机器参数抠准——电池容量是换算的关键。\n", result);
+    try std.testing.expect(std.mem.indexOf(u8, result, "</function") == null);
+}
+
+test "composeFinalReply strips the orphan closer even with a usage footer" {
+    const allocator = std.testing.allocator;
+    var agent = FakeAgent{ .allocator = allocator, .reasoning_mode = .off, .usage_mode = .tokens };
+    const usage = providers.TokenUsage{ .total_tokens = 7 };
+    const result = try composeFinalReply(&agent, "答案。\n</function>", null, usage);
+    defer allocator.free(result);
+    try std.testing.expect(std.mem.indexOf(u8, result, "</function") == null);
+    try std.testing.expect(std.mem.indexOf(u8, result, "total_tokens=7") != null);
+    try std.testing.expect(std.mem.startsWith(u8, result, "答案。\n"));
+}
+
+test "composeFinalReply keeps a tool-call sample inside a code fence" {
+    const allocator = std.testing.allocator;
+    var agent = FakeAgent{ .allocator = allocator, .reasoning_mode = .off };
+    const usage = providers.TokenUsage{};
+    const doc = "Example:\n```xml\n<function_calls></function_calls>\n```\ndone";
+    const result = try composeFinalReply(&agent, doc, null, usage);
+    defer allocator.free(result);
+    try std.testing.expect(std.mem.indexOf(u8, result, "<function_calls>") != null);
+}
+
 test "composeFinalReply on mode strips tool-call markup from the reasoning quote" {
     const allocator = std.testing.allocator;
     var agent = FakeAgent{ .allocator = allocator, .reasoning_mode = .on };
diff --git a/src/agent/root.zig b/src/agent/root.zig
index 119f698..7db83f5 100644
--- a/src/agent/root.zig
+++ b/src/agent/root.zig
@@ -971,6 +971,7 @@ pub const Agent = struct {
     const TOOL_USE_WITHOUT_CALL_NUDGE = "SYSTEM: The previous turn stopped for tool use but contained no tool call, so nothing ran. Continue from the current state: call the tool you need through the tool interface instead of writing the call as text, or produce the visible answer now. Do not restart from scratch.";
     const SETTLED_TOOLS_NO_ANSWER_NUDGE = "SYSTEM: The previous assistant turn completed its tool calls but did not produce a user-visible answer. Continue from the current transcript and produce the final user-visible answer now. Do not repeat completed tool calls or restart from scratch.";
     const REASONING_ONLY_NUDGE = "SYSTEM: The previous assistant turn recorded reasoning but did not produce a user-visible answer. Continue from that partial turn and produce the visible answer now. Do not restate the reasoning or restart from scratch.";
+    const TEXT_TOOL_CALL_NUDGE = "SYSTEM: The previous reply contained tool-call markup (for example a stray </function> closer) but no executable tool call was parsed, so nothing ran for that call. Continue from the current state: call the tool you need through the tool interface, or produce the final user-visible answer now. Do not print tool-call markup.";
 
     const EmptyResponseNudge = enum { generic, settled_tools, reasoning_only };
 
@@ -2226,6 +2227,7 @@ pub const Agent = struct {
         var forced_follow_through_count: u32 = 0;
         var empty_response_retry_count: u32 = 0;
         var tool_use_retry_count: u32 = 0;
+        var text_tool_call_retry_count: u32 = 0;
         var tools_ran_this_turn: bool = false;
         var seen_tool_call_results: std.AutoHashMapUnmanaged(u64, CachedToolCallResult) = .empty;
         defer deinitSeenToolCallResults(self.allocator, &seen_tool_call_results);
@@ -2731,6 +2733,31 @@ pub const Agent = struct {
                     return error.NoResponseContent;
                 }
 
+                // A reply whose visible text still carries a dangling tool-call
+                // closer (a garbled text tool call: the prod reply announced one
+                // more round and then emitted a lone `</function>`) is an
+                // incomplete turn, not an answer. The signal is structural, so
+                // it works for a reply the prose phrase list below cannot match.
+                // Nudge once with the same bounded machinery as the other
+                // stalls; if it recurs the reply is delivered with the markup
+                // stripped (composeFinalReply), never verbatim.
+                if (text_tool_call_retry_count < 1 and
+                    iteration + 1 < self.max_tool_iterations and
+                    (try providers.helpers.hasOrphanToolCallClose(self.allocator, display_text)))
+                {
+                    // Store the markup-free text so no re-render of history leaks
+                    // the closer and the model does not re-read its own garbled
+                    // text tool call.
+                    const nudge_text = try providers.stripToolCallMarkup(self.allocator, display_text);
+                    defer self.allocator.free(nudge_text);
+                    try self.appendOwnedHistoryMessage(.{ .role = .assistant, .content = try self.dupeForHistory(nudge_text) });
+                    try self.appendOwnedHistoryMessage(.{ .role = .user, .content = try self.allocator.dupe(u8, TEXT_TOOL_CALL_NUDGE) });
+                    self.trimHistory();
+                    self.freeResponseFields(&response);
+                    text_tool_call_retry_count += 1;
+                    continue;
+                }
+
                 // Guardrail: if the model promises "I'll try/check now" but emits no
                 // tool call, force one follow-up completion to either act now or
                 // explicitly state the limitation without deferred promises.
@@ -2778,10 +2805,15 @@ pub const Agent = struct {
                 const final_text = try self.composeFinalReply(base_text, response.reasoning_content, response.usage);
                 errdefer self.allocator.free(final_text);
 
-                // Dupe from display_text directly (not from final_text) to avoid double-dupe
+                // Store the same markup-free text the user saw: composeFinalReply
+                // strips tool-call markup for delivery, so history must match it
+                // (a re-render of history must not leak the closer, and the model
+                // must not re-read its own garbled text tool call next turn).
+                const history_text = try providers.stripToolCallMarkup(self.allocator, display_text);
+                defer self.allocator.free(history_text);
                 try self.history.append(self.allocator, .{
                     .role = .assistant,
-                    .content = try self.dupeForHistory(display_text),
+                    .content = try self.dupeForHistory(history_text),
                 });
 
                 // Auto-compaction before hard trimming to preserve context.
@@ -13799,3 +13831,150 @@ test "Agent turn returns announcing prose without a structural retry (step-5 sha
     try std.testing.expectEqualStrings("先把 key 拿出来，改脚本重测。", response);
     try std.testing.expectEqual(@as(usize, 1), state.idx);
 }
+
+test "Agent turn nudges once on a garbled text tool call and delivers the clean retry" {
+    // Prod shape: announcing prose followed by a lone orphan `</function>`
+    // closer and no executable call. The guard retries once; the retry's real
+    // answer is delivered with no markup.
+    const allocator = std.testing.allocator;
+    const garbled = "核心数据到手了。最后一轮，把对比表和机器参数抠准——电池容量是换算的关键。\n</function>";
+    var state = ScriptedTurnProvider{ .scripts = &[_]TurnScript{
+        .{ .text = garbled },
+        .{ .text = "最终答案：电池容量 5000mAh。" },
+    } };
+    const provider = scriptedProvider(&state);
+    var noop = observability.NoopObserver{};
+    var agent = makeTurnAgent(allocator, provider, &[_]Tool{}, try allocator.alloc(ToolSpec, 0), noop.observer());
+    defer agent.deinit();
+
+    const response = try agent.turn("继续");
+    defer allocator.free(response);
+    try std.testing.expectEqualStrings("最终答案：电池容量 5000mAh。", response);
+    try std.testing.expectEqual(@as(usize, 2), state.idx);
+}
+
+test "Agent turn delivers the stripped answer when the text tool call recurs" {
+    const allocator = std.testing.allocator;
+    const garbled = "核心数据到手了。最后一轮，把对比表和机器参数抠准——电池容量是换算的关键。\n</function>";
+    var state = ScriptedTurnProvider{ .scripts = &[_]TurnScript{
+        .{ .text = garbled },
+        .{ .text = garbled },
+    } };
+    const provider = scriptedProvider(&state);
+    var noop = observability.NoopObserver{};
+    var agent = makeTurnAgent(allocator, provider, &[_]Tool{}, try allocator.alloc(ToolSpec, 0), noop.observer());
+    defer agent.deinit();
+
+    const response = try agent.turn("继续");
+    defer allocator.free(response);
+    // The bounded retry is exhausted, so the reply is delivered with the markup
+    // stripped — never verbatim.
+    try std.testing.expectEqualStrings("核心数据到手了。最后一轮，把对比表和机器参数抠准——电池容量是换算的关键。\n", response);
+    try std.testing.expect(std.mem.indexOf(u8, response, "</function") == null);
+    try std.testing.expectEqual(@as(usize, 2), state.idx);
+}
+
+test "Agent turn does not retry a balanced function-markup answer" {
+    // A balanced pair outside a code fence is prose, not a garbled call, so the
+    // structural guard does not fire.
+    const allocator = std.testing.allocator;
+    var state = ScriptedTurnProvider{ .scripts = &[_]TurnScript{
+        .{ .text = "Use <function name=\"read\">body</function> in the docs." },
+    } };
+    const provider = scriptedProvider(&state);
+    var noop = observability.NoopObserver{};
+    var agent = makeTurnAgent(allocator, provider, &[_]Tool{}, try allocator.alloc(ToolSpec, 0), noop.observer());
+    defer agent.deinit();
+
+    const response = try agent.turn("hi");
+    defer allocator.free(response);
+    try std.testing.expectEqual(@as(usize, 1), state.idx);
+    try std.testing.expect(std.mem.indexOf(u8, response, "in the docs.") != null);
+    try std.testing.expect(std.mem.indexOf(u8, response, "</function") == null);
+}
+
+test "Agent turn nudges once on a truncated function= text tool call" {
+    // OpenAI `=` dialect: the model announces a search and emits a bare
+    // `<function=web_search>` with no close. It is a garbled text tool call, so
+    // the guard retries once and the clean retry is delivered.
+    const allocator = std.testing.allocator;
+    var state = ScriptedTurnProvider{ .scripts = &[_]TurnScript{
+        .{ .text = "先查一下。\n<function=web_search>" },
+        .{ .text = "最终答案。" },
+    } };
+    const provider = scriptedProvider(&state);
+    var noop = observability.NoopObserver{};
+    var agent = makeTurnAgent(allocator, provider, &[_]Tool{}, try allocator.alloc(ToolSpec, 0), noop.observer());
+    defer agent.deinit();
+
+    const response = try agent.turn("查");
+    defer allocator.free(response);
+    try std.testing.expectEqualStrings("最终答案。", response);
+    try std.testing.expectEqual(@as(usize, 2), state.idx);
+}
+
+test "Agent turn delivers the stripped answer when the function= call recurs" {
+    const allocator = std.testing.allocator;
+    var state = ScriptedTurnProvider{ .scripts = &[_]TurnScript{
+        .{ .text = "先查一下。\n<function=web_search>" },
+        .{ .text = "先查一下。\n<function=web_search>" },
+    } };
+    const provider = scriptedProvider(&state);
+    var noop = observability.NoopObserver{};
+    var agent = makeTurnAgent(allocator, provider, &[_]Tool{}, try allocator.alloc(ToolSpec, 0), noop.observer());
+    defer agent.deinit();
+
+    const response = try agent.turn("查");
+    defer allocator.free(response);
+    // The bounded retry is exhausted, so the reply is delivered with the markup
+    // stripped, never verbatim.
+    try std.testing.expectEqualStrings("先查一下。\n", response);
+    try std.testing.expect(std.mem.indexOf(u8, response, "<function=") == null);
+    try std.testing.expectEqual(@as(usize, 2), state.idx);
+}
+
+test "Agent turn stores the history reply free of tool-call markup" {
+    // The delivered reply is stripped, and so is every stored assistant entry:
+    // a re-render of history must not leak the closer, and the model must not
+    // re-read its own garbled text tool call.
+    const allocator = std.testing.allocator;
+    const garbled = "核心数据到手了。\n</function>";
+    var state = ScriptedTurnProvider{ .scripts = &[_]TurnScript{
+        .{ .text = garbled },
+        .{ .text = garbled },
+    } };
+    const provider = scriptedProvider(&state);
+    var noop = observability.NoopObserver{};
+    var agent = makeTurnAgent(allocator, provider, &[_]Tool{}, try allocator.alloc(ToolSpec, 0), noop.observer());
+    defer agent.deinit();
+
+    const response = try agent.turn("继续");
+    defer allocator.free(response);
+    try std.testing.expectEqual(@as(usize, 2), state.idx);
+
+    var saw_answer = false;
+    for (agent.history.items) |msg| {
+        if (msg.role != .assistant) continue;
+        try std.testing.expect(std.mem.indexOf(u8, msg.content, "</function") == null);
+        if (std.mem.indexOf(u8, msg.content, "核心数据到手了。") != null) saw_answer = true;
+    }
+    try std.testing.expect(saw_answer);
+}
+
+test "Agent turn nudges on a lone closer after an unclosed fence" {
+    const allocator = std.testing.allocator;
+    const garbled = "好的，对比表如下：\n```\n| 机型 | 电池容量 |\n</function>";
+    var state = ScriptedTurnProvider{ .scripts = &[_]TurnScript{
+        .{ .text = garbled },
+        .{ .text = "最终答案。" },
+    } };
+    const provider = scriptedProvider(&state);
+    var noop = observability.NoopObserver{};
+    var agent = makeTurnAgent(allocator, provider, &[_]Tool{}, try allocator.alloc(ToolSpec, 0), noop.observer());
+    defer agent.deinit();
+
+    const response = try agent.turn("继续");
+    defer allocator.free(response);
+    try std.testing.expectEqual(@as(usize, 2), state.idx);
+    try std.testing.expectEqualStrings("最终答案。", response);
+}
diff --git a/src/channels/slack.zig b/src/channels/slack.zig
index f86a2b7..6af1781 100644
--- a/src/channels/slack.zig
+++ b/src/channels/slack.zig
@@ -1967,7 +1967,20 @@ pub const SlackChannel = struct {
         const parsed = stream_presenter.resolveStreamTarget(target);
 
         if (state.mode == .native) {
-            if (state.message_ts.len == 0) {
+            if (flush.native_full) {
+                // The accumulated snapshot has outgrown Slack's message cap, so
+                // the next chat.appendStream would answer `msg_too_long` -- a
+                // per-call split cannot prevent a cumulative overflow. Close the
+                // stream and finish on the edited-message transport, whose
+                // chat.update is capped at STREAM_UPDATE_MAX_BYTES and whose
+                // overflow goes out as thread follow-ups.
+                if (state.message_ts.len > 0) {
+                    self.stopNativeStream(parsed, state.message_ts) catch |err| {
+                        log.warn("Slack chat.stopStream failed ({s})", .{@errorName(err)});
+                    };
+                }
+                state.mode = .fallback;
+            } else if (state.message_ts.len == 0) {
                 self.startNativeStreamLocked(parsed, state, flush.text) catch |err| {
                     log.warn("Slack chat.startStream failed ({s}); using edited messages", .{@errorName(err)});
                     state.mode = .fallback;
@@ -1986,7 +1999,21 @@ pub const SlackChannel = struct {
                 // Keep the native transport: the streamed message still has to be
                 // closed with chat.stopStream, and the final reply reconciles it.
                 self.appendNativeStreamLocked(parsed, state, flush.delta()) catch |err| {
-                    log.warn("Slack chat.appendStream failed ({s}); continuing without live updates", .{@errorName(err)});
+                    // A failed append — most likely `msg_too_long` once the
+                    // message passes Slack's cumulative cap, which a per-call
+                    // split cannot foresee — leaves the native stream unusable
+                    // for this turn. Close it now rather than only stopping live
+                    // updates: otherwise a turn with no final body can leave the
+                    // message stuck in the streaming state. Finish on the
+                    // edited-message transport, whose chat.update is capped and
+                    // splits, so the final reply is still delivered intact.
+                    log.warn("Slack chat.appendStream failed ({s}); finishing on edited messages", .{@errorName(err)});
+                    if (state.message_ts.len > 0) {
+                        self.stopNativeStream(parsed, state.message_ts) catch |stop_err| {
+                            log.warn("Slack chat.stopStream failed ({s})", .{@errorName(stop_err)});
+                        };
+                    }
+                    state.mode = .fallback;
                     state.send_failed = true;
                 };
             }
@@ -2183,8 +2210,18 @@ pub const SlackChannel = struct {
         const parsed = stream_presenter.resolveStreamTarget(target);
 
         if (state.mode == .native) {
-            const stream_completed = if (stream_presenter.pendingFinalSuffix(message, state.sent)) |suffix| blk: {
-                self.appendNativeStreamLocked(parsed, state, suffix) catch |err| {
+            const suffix = stream_presenter.pendingFinalSuffix(message, state.sent);
+            // The closing append must respect the same cumulative budget as the
+            // live flushes: when the answer lands inside one throttle window the
+            // whole remainder is appended in a single call, and chat.appendStream
+            // would answer `msg_too_long` past Slack's message cap. Finish on the
+            // edited-message transport instead so the answer is delivered intact.
+            const over_budget = if (suffix) |s|
+                stream_presenter.finalAppendOverflowsBudget(state.sent.len, s.len)
+            else
+                false;
+            const stream_completed = if (suffix != null and !over_budget) blk: {
+                self.appendNativeStreamLocked(parsed, state, suffix.?) catch |err| {
                     log.warn("Slack chat.appendStream final delta failed ({s})", .{@errorName(err)});
                     break :blk false;
                 };
@@ -2198,8 +2235,10 @@ pub const SlackChannel = struct {
             // A streamed reasoning quote is deliberately absent from the final
             // reply, so that turn's snapshot can never be a prefix of it.
             // Rewrite the stopped message in place rather than leaving the
-            // thinking behind and posting the reply a second time.
-            if (state.rendered_reasoning) {
+            // thinking behind and posting the reply a second time. The same
+            // rewrite carries a final message that would overflow the stream
+            // budget.
+            if (state.rendered_reasoning or over_budget) {
                 return self.deliverFallbackFinal(parsed, state.message_ts, message, media, target);
             }
             // When the stream could not be completed the streamed message keeps
@@ -2524,6 +2563,50 @@ test "slack channel init defaults" {
     _ = ch.channelName();
 }
 
+test "slack native stream finishes on the fallback transport past the message budget" {
+    // Slack caps the whole streamed message, so a long turn must leave the
+    // native transport before chat.appendStream answers `msg_too_long`; the
+    // edited-message transport (chat.update + thread follow-ups) then carries
+    // the final answer intact.
+    const allocator = std.testing.allocator;
+    const allowed = [_][]const u8{"U123"};
+    var ch = SlackChannel.init(allocator, "xoxb-test", null, "C123", &allowed);
+    defer stream_presenter.deinitStreamStates(allocator, &ch.stream_states);
+
+    const target = "C123:1700000000.000100";
+    const big = "x" ** (stream_presenter.STREAM_TOTAL_MAX_BYTES + 1);
+    ch.streamChunk(target, big);
+
+    const state = ch.stream_states.getPtr(target) orelse return error.TestUnexpectedResult;
+    try std.testing.expectEqual(stream_presenter.StreamMode.fallback, state.mode);
+    try std.testing.expect(state.message_ts.len > 0);
+}
+
+test "slack native stream leaves for the fallback transport when a later flush crosses the budget" {
+    // Start the native stream with a sub-budget chunk, then cross the cumulative
+    // budget on a later flush: the stream must be closed and the turn finished
+    // on the edited-message transport, with the message ts kept for the rewrite.
+    const allocator = std.testing.allocator;
+    const allowed = [_][]const u8{"U123"};
+    var ch = SlackChannel.init(allocator, "xoxb-test", null, "C123", &allowed);
+    defer stream_presenter.deinitStreamStates(allocator, &ch.stream_states);
+
+    const target = "C123:1700000000.000100";
+    const part = "x" ** 7_000;
+    ch.streamChunk(target, part);
+    const first = ch.stream_states.getPtr(target) orelse return error.TestUnexpectedResult;
+    try std.testing.expectEqual(stream_presenter.StreamMode.native, first.mode);
+    try std.testing.expect(first.message_ts.len > 0);
+
+    // Force the next flush past the coalescing window without waiting a second.
+    first.last_flush_time = 0;
+    ch.streamChunk(target, part);
+
+    const second = ch.stream_states.getPtr(target) orelse return error.TestUnexpectedResult;
+    try std.testing.expectEqual(stream_presenter.StreamMode.fallback, second.mode);
+    try std.testing.expect(second.message_ts.len > 0);
+}
