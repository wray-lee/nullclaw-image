+    try std.testing.expectEqualStrings("C123", slackChannelIdOf("C123").?);
+    try std.testing.expect(slackChannelIdOf("") == null);
+    try std.testing.expect(slackChannelIdOf(":1700000000.000000") == null);
+}
+
