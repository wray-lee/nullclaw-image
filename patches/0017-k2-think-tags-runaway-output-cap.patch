     return std.mem.indexOf(u8, text, "<tool_call>") != null or
         std.mem.indexOf(u8, text, "</tool_call>") != null or
         std.mem.indexOf(u8, text, "[TOOL_CALL]") != null or
         std.mem.indexOf(u8, text, "[tool_call]") != null or
         std.mem.indexOf(u8, text, "[/TOOL_CALL]") != null or
-        std.mem.indexOf(u8, text, "[/tool_call]") != null;
+        std.mem.indexOf(u8, text, "[/tool_call]") != null or
+        providers.helpers.hasRepetitiveToolCloseRun(text);
 }
 
