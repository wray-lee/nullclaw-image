 src/agent/cli.zig                       |   4 +
 src/agent/dispatcher.zig                |  21 +-
 src/channels/max.zig                    |  21 +-
 src/channels/slack.zig                  |  10 +
 src/channels/slack_stream_presenter.zig |  55 +-
 src/providers/helpers.zig               | 651 ++++++++++++++++++++++--
 src/providers/root.zig                  |   1 +
 src/providers/sse.zig                   |  23 +
 src/streaming.zig                       | 254 ++++++++-
 10 files changed, 983 insertions(+), 60 deletions(-)

