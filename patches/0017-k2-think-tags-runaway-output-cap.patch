 // close is matched with either a `>` or a whitespace delimiter, so a model that
@@ -92,6 +331,11 @@ const tool_call_close_names = [_][]const u8{
     "<tool_result_end",
     "<|tool_call_end|",
     "<|tool_result_end|",
+    "</function",
+    "</function_calls",
+    "</tool_calls",
+    "</invoke",
+    "</parameter",
 };
