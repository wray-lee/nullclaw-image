+        try input.appendSlice(a, "A<tool_call>{\"name\":\"shell\",\"arguments\":{}}</tool_call>B");
+        try expected.appendSlice(a, "AB");
+    }
+    try assertEverySplit(input.items, expected.items, expected.items, expected.items);
+}
