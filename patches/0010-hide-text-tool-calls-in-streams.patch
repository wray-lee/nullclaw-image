+        // `<`, exactly like the streaming filter.
+        const gt = std.mem.indexOfScalarPos(u8, text, i + 1, '>');
+        const lt = std.mem.indexOfScalarPos(u8, text, i + 1, '<');
+        if (lt != null and (gt == null or lt.? < gt.?)) return lt.?;
