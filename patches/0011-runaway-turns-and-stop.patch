+                        "<tool_call>{\"name\":\"dup_tool\",\"arguments\":{}}</tool_call>"),
+                    .model = try allocator_.dupe(u8, "test-model"),
+                };
+            }
+            return .{
+                .content = try allocator_.dupe(u8, "done"),
+                .model = try allocator_.dupe(u8, "test-model"),
