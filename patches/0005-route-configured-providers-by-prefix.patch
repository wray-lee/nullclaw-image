+    try std.testing.expect(prov.supportsStreamingNativeToolsForModel("newapi/dpsk"));
+    // A bare model still resolves to the primary provider.
+    try std.testing.expect(!prov.supportsStreamingNativeToolsForModel("dpsk"));
